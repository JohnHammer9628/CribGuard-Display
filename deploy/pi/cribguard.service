[Unit]
# Install this unit as: /etc/systemd/system/cribguard@.service
# Enable with user instance: sudo systemctl enable --now cribguard@<user>.service
Description=CribGuard UI (LVGL/SDL KMS/DRM)
After=multi-user.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
Group=%i
Environment=CRIBGUARD_USER=%i
EnvironmentFile=-/etc/default/cribguard
ExecStart=/usr/local/bin/cribguard-run.sh
Restart=always
# Allow in-app "Exit To Desktop" without immediate relaunch.
RestartPreventExitStatus=200
RestartSec=2

[Install]
WantedBy=multi-user.target


