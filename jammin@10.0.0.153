#!/usr/bin/env python3
"""
Legacy entrypoint (kept for compatibility).

The canonical Baby Pi server implementation lives at:
  `baby-pi/camera_control_server.py`

This file remains runnable so existing demo/deployment notes that used
`./jammin@10.0.0.153` continue to work during cleanup.
"""

from __future__ import annotations

import runpy
from pathlib import Path

here = Path(__file__).resolve().parent
canonical = here / "baby-pi" / "camera_control_server.py"

if not canonical.exists():
    raise SystemExit(
        "Canonical server not found at baby-pi/camera_control_server.py. "
        "Run the canonical file directly or restore it in the repo."
    )

runpy.run_path(str(canonical), run_name="__main__")

"""
The original server implementation has been relocated to `baby-pi/camera_control_server.py`.
"""

