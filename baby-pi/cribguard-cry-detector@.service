[Unit]
Description=CribGuard Cry Detector Service
After=network.target sound.target
Wants=network.target

[Service]
Type=simple
User=%i
Group=%i
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/default/cribguard-cry-detector
ExecStart=/usr/bin/env python3 /usr/local/bin/cribguard-cry-detector.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
